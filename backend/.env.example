# Ruchita Interiors - backend environment template.
# Copy this file to .env and adjust as needed. Never commit .env.
#
# Generate the two secret keys rather than copying the placeholders:
#   python -c "import secrets; print(secrets.token_hex(32))"

# development | production
FLASK_ENV=development
FLASK_DEBUG=true

# Session key for Flask. Generated per process when unset, which is fine for
# development but means sessions do not survive a restart. Mandatory in production.
SECRET_KEY=change-me

# Separate signing key for access/refresh JWTs. Must be different from
# SECRET_KEY, so rotating one cannot silently invalidate the other. Mandatory
# in production, where a random per-process value would break every session on
# every restart.
JWT_SECRET_KEY=change-me-too

# Token lifetimes, in seconds. Defaults shown.
# 15 minutes for access, 30 days for the sliding refresh window.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Relative paths resolve against backend/instance/.
DATABASE_URL=sqlite:///ruchita_interiors.db

# Comma-separated list of allowed CORS origins for /api/*. Falls back to
# FRONTEND_URL when unset, so an existing .env keeps working.
#
# Only needed when the frontend calls the API from a different origin. The default
# VITE_API_BASE_URL is relative and the dev server proxies /api, so a same-origin
# setup needs no entry here at all.
#
# List every origin you actually use. Note that "localhost" and "127.0.0.1" are
# different entries, and the browser treats them as different sites for SameSite
# cookies - an origin missing here is silently blocked, which surfaces in the UI as
# "Cannot reach the server" rather than as a CORS error.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seeded owner account, consumed by `flask seed-admin` and never by a request
# handler. ADMIN_PASSWORD must be at least 10 characters.
ADMIN_EMAIL=admin@ruchitainteriors.in
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_NAME=Ruchita Interiors

# Login rate limit: failures per window, per IP + email. Failures are counted
# rather than attempts, so a successful sign-in clears the history.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# X-Forwarded-For is client-controlled. Leave off unless a reverse proxy that
# sets the header is deployed in front of the API, or the login rate limit can be
# bypassed with a forged IP. TRUSTED_PROXY_COUNT is the number of proxies that
# append to the header; the address before them is treated as the real client.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1

# Bind address. 127.0.0.1 keeps the dev API off the local network. Render sets
# PORT itself and binds gunicorn to 0.0.0.0, so neither is needed in production.
HOST=127.0.0.1
PORT=5000

# ---------- Deployment (Render) ----------
# The blueprint at the repository root sets all of these; they are listed here so
# the file stays the single reference. See README "Deploying to Render".

# Where the built frontend lives, so one origin serves both the API and the SPA.
# Defaults to ../frontend/dist relative to this file. When the directory has no
# index.html the app stays API-only, which is what development and the tests use.
# SPA_DIST_DIR=../frontend/dist

# On the Render Free tier these are container-local, because Free services have an
# EPHEMERAL filesystem and no persistent disk is available. The database and every
# uploaded image are therefore lost on redeploy, restart, and on the 15-minute idle
# spin-down. Fine for a demo, not for real invoices. See README "Deploying to
# Render" before putting business data in it.
# DATABASE_URL=sqlite:///instance/ruchita_interiors.db
# UPLOADS_DIR=uploads

# Migrate the schema, seed the default rows and create the single owner account at
# start-up, using ADMIN_EMAIL / ADMIN_PASSWORD above. Needed on Render Free, which
# has no shell access and no pre-deploy command, so the two CLI commands in the
# Quick Start cannot be run against a fresh instance.
#
# Not a signup path: no HTTP route reaches it, it only runs when the users table is
# missing, and it creates exactly one owner. With no ADMIN_PASSWORD, or one under
# 10 characters, it creates nothing and logs why. Leave it off locally, where the
# documented `flask db upgrade` and `flask seed-admin` are the supported route.
# AUTO_SEED_ADMIN=true

# Render terminates TLS in front of the app and sets X-Forwarded-For, so the rate
# limiter has to trust that header or every client shares one rate-limit bucket.
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_COUNT=1
