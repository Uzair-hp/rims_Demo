{
  "name": "ruchita-interiors",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ruchita Interiors — quotations, invoices and clients (Phase 1 foundation).",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "dev": "concurrently --names api,web --prefix-colours yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-backend.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "dev:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 start",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 stop",
    "dev:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 restart",
    "dev:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 status",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "lint:fix": "npm --prefix frontend run lint:fix",
    "format": "npm --prefix frontend run format",
    "format:check": "npm --prefix frontend run format:check",
    "test": "npm --prefix frontend run test && npm run test:api",
    "test:web": "npm --prefix frontend run test",
    "test:api": "node scripts/run-tests.mjs",
    "test:coverage": "npm --prefix frontend run test:coverage",
    "verify": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
