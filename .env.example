# Ruchita Interiors - root environment reference.
#
# Each application keeps its own environment file. Copy the templates:
#
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env
#
# This root file is a convenience reference only. Never commit real .env files
# and never put real secrets anywhere.

# ---------- Backend (see backend/.env.example) ----------
FLASK_ENV=development
FLASK_DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Both keys are mandatory in production. They must differ, so rotating one
# cannot invalidate the other.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

DATABASE_URL=sqlite:///ruchita_interiors.db

# Comma-separated. Falls back to FRONTEND_URL when unset.
CORS_ORIGINS=http://localhost:5173

# Consumed only by `flask seed-admin`. Minimum 10 characters.
ADMIN_EMAIL=admin@ruchitainteriors.in
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_NAME=Ruchita Interiors

# Leave off unless a reverse proxy sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1

# ---------- Frontend (see frontend/.env.example) ----------
# The versioned API prefix is part of the base URL; no path is appended to it.
VITE_API_BASE_URL=http://localhost:5000/api/v1
