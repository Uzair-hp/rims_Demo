# ---------- Frontend ----------
node_modules/
dist/
dist-ssr/
# Service-worker output written by vite-plugin-pwa during `npm run dev`.
dev-dist/
# PythonAnywhere has no Node runtime and no build step, so the production bundle
# has to travel in the repository. Only frontend/dist is shipped; every other
# directory named `dist` stays ignored. Must stay after the `dist/` rule above:
# a file inside an ignored directory cannot be re-included by a later pattern.
!frontend/dist/
# Source maps are ~4.5 MB of the ~6 MB bundle and only affect devtools, so they
# stay out. Each rebuild fingerprints new filenames, which would otherwise leave a
# full copy of them in history on every deploy.
frontend/dist/**/*.map

# ---------- Dev server state ----------
# PID files, generated .cmd launchers and server logs from scripts/dev.ps1.
.dev/
*.local

# ---------- Backend ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---------- Environment ----------
# Never commit real environment files; keep the .example templates.
.env
.env.*
!.env.example

# ---------- Database (local SQLite) ----------
*.sqlite
*.sqlite3
instance/*.db
*.db
# WAL sidecar files. They appear beside the database in WAL mode (§8.5) and match
# no extension rule above, so they need naming explicitly.
*.db-shm
*.db-wal
*.db-journal
# Timestamped database backups, e.g. `ruchita_interiors.db.bak-20260930-001005`.
# These are full copies of the SQLite file and hold live business data, so they
# must never reach the repository. The `*.db` rule above does not catch them:
# the name ends in `-<timestamp>`, not `.db`.
*.db.bak*
# Any other backup of a database or config file, e.g. the pre-migration snapshots
# Alembic tooling leaves beside the live file as
# `ruchita_interiors.db.pre-<revision>.bak`. Those are full copies of the SQLite
# file and hold live business data, so they must never be committed. The rules
# above miss this shape: the name ends in `.bak` but does not contain `.db.bak`.
*.bak
# The WAL sidecars that belong to one of those `.bak` copies, e.g.
# `ruchita_interiors.db.pre-<revision>.bak-shm`. The `*.db-shm` / `*.db-wal`
# rules above do not match this shape either: the name ends in `-shm` / `-wal`,
# not `.db-shm`. They appear whenever a backup is opened with SQLite and they
# hold pages from the same live database, so they are as sensitive as the
# `.bak` file itself.
*.bak-shm
*.bak-wal
*.bak-journal

# ---------- Uploads ----------
# Keep the directory (via .gitkeep) but not uploaded files.
backend/uploads/*
!backend/uploads/.gitkeep

# ---------- Logs ----------
*.log
logs/

# ---------- Print-check output ----------
# Generated by `node scripts/print-check.mjs`: rendered PDFs and the HTML they are
# built from. Local diagnostics only - the PDFs are build artifacts of a build.
print-check/

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.swp

# ---------- Local agent tooling ----------
# Agent plan/worktree state, including the duplicate worktree it keeps under
# .kilo/worktrees. Local only: never part of the application.
.kilo/

# ---------- OS ----------
.DS_Store
Thumbs.db
