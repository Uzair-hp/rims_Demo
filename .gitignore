# ---------- Frontend ----------
node_modules/
dist/
dist-ssr/
# Service-worker output written by vite-plugin-pwa during `npm run dev`.
dev-dist/

# ---------- Dev server state ----------
# PID files, generated .cmd launchers and server logs from scripts/dev.ps1.
.dev/
*.local

# ---------- Backend ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---------- Environment ----------
# Never commit real environment files; keep the .example templates.
.env
.env.*
!.env.example

# ---------- Database (local SQLite) ----------
*.sqlite
*.sqlite3
instance/*.db
*.db
# WAL sidecar files. They appear beside the database in WAL mode (§8.5) and match
# no extension rule above, so they need naming explicitly.
*.db-shm
*.db-wal
*.db-journal
# Timestamped database backups, e.g. `ruchita_interiors.db.bak-20260930-001005`.
# These are full copies of the SQLite file and hold live business data, so they
# must never reach the repository. The `*.db` rule above does not catch them:
# the name ends in `-<timestamp>`, not `.db`.
*.db.bak*

# ---------- Uploads ----------
# Keep the directory (via .gitkeep) but not uploaded files.
backend/uploads/*
!backend/uploads/.gitkeep

# ---------- Logs ----------
*.log
logs/

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.swp

# ---------- Local agent tooling ----------
# Agent plan/worktree state, including the duplicate worktree it keeps under
# .kilo/worktrees. Local only: never part of the application.
.kilo/

# ---------- OS ----------
.DS_Store
Thumbs.db
