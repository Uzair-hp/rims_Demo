# Ruchita Interiors - frontend environment template.
# Copy this file to .env and adjust as needed. Never commit .env.

# Base URL of the backend API, including the version prefix.
#
# Leave this as the relative path. The dev server proxies /api to Flask
# (see vite.config.js) and production serves both from one origin, so a relative
# URL makes every call same-origin.
#
# Do not point this at the API's absolute URL. Auth cookies are SameSite=Lax, and
# browsers treat "localhost" and "127.0.0.1" as different sites, so an absolute
# URL can withhold the refresh cookie and requires the frontend origin to be
# listed in CORS_ORIGINS. Both failures look identical in the browser: every
# request reports "Cannot reach the server" and login never completes.
VITE_API_BASE_URL=/api/v1
