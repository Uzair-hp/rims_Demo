# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# `dist` is intentionally NOT ignored here. This file is a child of the root
# .gitignore and wins any conflict, so a `dist` line in it would override the
# root's `!frontend/dist/` exception and the PythonAnywhere build would have to
# be produced on the server, which has no Node runtime.
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
